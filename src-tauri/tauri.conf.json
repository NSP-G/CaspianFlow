{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaspianFlow",
  "version": "0.1.0",
  "identifier": "com.caspian.flow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CaspianFlow",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CaspianFlow",
    "category": "Productivity",
    "shortDescription": "Local-first AI agent runtime",
    "longDescription": "CaspianFlow is a local-first AI agent runtime. Agents, skills, workflows, knowledge and themes all live under ~/.caspian/ — nothing leaves the machine unless you explicitly configure an external provider. Import/export uses the .caspian package format.",
    "license": "MIT",
    "copyright": "Copyright © 2026 CaspianFlow contributors",
    "fileAssociations": [
      {
        "ext": ["caspian"],
        "name": "CaspianFlow Package",
        "description": "CaspianFlow export package (agents, skills, memory, sessions, config)",
        "role": "Viewer",
        "mimeType": "application/x-caspian"
      }
    ],
    "createUpdaterArtifacts": true,
    "linux": {},
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "files": {}
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "SimpChinese"],
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.caspianflow.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY_ED25519_BASE64",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
